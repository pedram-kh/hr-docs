{"repeat":0,"id":"wt-12-permiso-matrimonio","class":"whitelist_info","engine":"agent","skipped":false,"note":null,"outcome":"answer","expected_outcome":null,"reason":null,"path":"reference_fact_composition","authority":["official_convenio","structured_reference"],"pass":true,"must_not_answer_violated":false,"hard_kind":null,"lane_answer":false,"caveat_ok":null,"answer_excerpt":"Por matrimonio tienes derecho a 20 días naturales de licencia retribuida [Fuente 1] [Fuente 3]. Las parejas de hecho, acreditando debidamente la convivencia, generan los mismos derechos que los previstos para el matrimonio en este artículo [Fuente 2] [Fuente 3].","forbidden_ask_reached":false,"ask_attempted":false,"ask_denied":false,"first_tool":"reference_fact","first_tool_executed":null,"expected_first_tool":null,"terminal":"finalize","expected_terminal":null,"rule_verdicts":0,"rule_overrides":0,"forced_terminations":0,"tokens_prompt":20192,"tokens_completion":317,"cost_usd":0.065331,"latency_ms":7160,"session_uuid":"a053cf07-a4e2-46ed-b430-6a527eb83f0c","message_id":4861}
{"repeat":1,"id":"wt-12-permiso-matrimonio","class":"whitelist_info","engine":"agent","skipped":false,"note":null,"outcome":"answer","expected_outcome":null,"reason":null,"path":"reference_fact_composition","authority":["official_convenio","structured_reference"],"pass":true,"must_not_answer_violated":false,"hard_kind":null,"lane_answer":false,"caveat_ok":null,"answer_excerpt":"Por matrimonio tienes derecho a 20 días naturales de licencia retribuida [Fuente 1] [Fuente 3]. Este mismo derecho se aplica también a las parejas de hecho, siempre que la convivencia se acredite de forma suficiente (por ejemplo, mediante certificado de empadronamiento común, certificación de registro de parejas de hecho u otro documento oficial equivalente) [Fuente 2] [Fuente 3].","forbidden_ask_reached":false,"ask_attempted":false,"ask_denied":false,"first_tool":"reference_fact","first_tool_executed":null,"expected_first_tool":null,"terminal":"finalize","expected_terminal":null,"rule_verdicts":0,"rule_overrides":0,"forced_terminations":0,"tokens_prompt":20235,"tokens_completion":447,"cost_usd":0.06741,"latency_ms":7977,"session_uuid":"5d754497-45b8-49fc-8389-707e389c7ba6","message_id":4863}
