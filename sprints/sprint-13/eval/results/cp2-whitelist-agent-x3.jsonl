{"repeat":0,"id":"wt-01-group3-empty","class":"whitelist_convenio_wide","engine":"agent","skipped":false,"note":null,"outcome":"answer","expected_outcome":null,"reason":null,"path":"reference_fact_composition","authority":["official_convenio"],"pass":true,"must_not_answer_violated":false,"hard_kind":null,"lane_answer":false,"caveat_ok":true,"answer_excerpt":"El convenio no distingue las vacaciones por grupo profesional: establece que todo el personal comprendido en el Convenio disfrutará de un período de vacaciones anual mínimo de 31 días naturales, de los cuales 26 serán laborables (considerando los sábados o, en su caso, los lunes, como día laborable completo) [Fuente 1]. Esta duración se aplica con independencia del grupo profesional, ya que las fuentes disponibles no establecen ninguna diferenciación de días de vacaciones según el grupo 3 ni ningún otro grupo profesional [Fuente 1].","forbidden_ask_reached":false,"ask_attempted":false,"ask_denied":false,"first_tool":"reference_fact","first_tool_executed":null,"expected_first_tool":null,"terminal":"finalize","expected_terminal":null,"rule_verdicts":0,"rule_overrides":0,"forced_terminations":0,"tokens_prompt":15119,"tokens_completion":824,"cost_usd":0.057717,"latency_ms":11088,"session_uuid":"b7deeddc-e298-4921-be01-0a8cc800367e","message_id":4795}
